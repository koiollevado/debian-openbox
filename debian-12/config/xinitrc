#!/bin/sh
# ~/.xinitrc — template do projeto openbox-mini
# Executado pelo slim via startx.

# Merge de X resources (opcional, mas padrão)
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# Compositor opcional (descomente se instalar picom/xcompmgr)
# picom --daemon &

# Sessão Openbox
exec openbox-session