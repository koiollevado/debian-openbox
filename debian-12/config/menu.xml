<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://openbox.org/ file:///usr/share/openbox/menu.xsd">

  <menu id="root-menu" label="Aplicativos">

    <!-- ============ CONFIGURAÇÃO ============ -->
    <menu id="Configuracao" label="Configuração">
      <item label="Aparência (LXAppearance)">
        <action name="Execute">
          <command>lxappearance</command>
        </action>
      </item>
      <item label="Preferências do Desktop (PCManFM)">
        <action name="Execute">
          <command>pcmanfm --desktop-pref</command>
        </action>
      </item>
      <item label="Gerenciador do Openbox (ObConf)">
        <action name="Execute">
          <command>obconf</command>
        </action>
      </item>
      <item label="Editor de Menu (ObMenu)">
        <action name="Execute">
          <command>obmenu</command>
        </action>
      </item>
    </menu>

    <!-- ============ DESENVOLVIMENTO ============ -->
    <menu id="Desenvolvimento" label="Desenvolvimento">
      <item label="Geany">
        <action name="Execute">
          <command>geany</command>
        </action>
      </item>
    </menu>

    <!-- ============ GRÁFICO ============ -->
    <menu id="Grafico" label="Gráfico">
      <item label="Feh (Visualizador de Imagens)">
        <action name="Execute">
          <command>feh</command>
        </action>
      </item>
      <item label="Captura de Tela (GNOME Screenshot)">
        <action name="Execute">
          <command>gnome-screenshot --interactive</command>
        </action>
      </item>
    </menu>

    <!-- ============ INTERNET ============ -->
    <menu id="Internet" label="Internet">
      <!-- Os itens abaixo só funcionam se o Script 5 instalou o navegador correspondente. -->
      <item label="Chromium">
        <action name="Execute">
          <command>chromium</command>
        </action>
      </item>
      <item label="Firefox ESR">
        <action name="Execute">
          <command>firefox-esr</command>
        </action>
      </item>
      <item label="Firefox (Latest)">
        <action name="Execute">
          <command>firefox</command>
        </action>
      </item>
      <item label="Google Chrome">
        <action name="Execute">
          <command>google-chrome-stable</command>
        </action>
      </item>
      <item label="Brave Browser">
        <action name="Execute">
          <command>brave-browser</command>
        </action>
      </item>
    </menu>

    <!-- ============ MULTIMÍDIA ============ -->
    <menu id="Multimidia" label="Multimídia">
      <item label="Controle de Volume (PulseAudio)">
        <action name="Execute">
          <command>pavucontrol</command>
        </action>
      </item>
      <item label="VLC Media Player">
        <action name="Execute">
          <command>vlc --started-from-file</command>
        </action>
      </item>
    </menu>

    <!-- ============ SISTEMA ============ -->
    <menu id="Sistema" label="Sistema">
      <item label="Conky (Monitor)">
        <action name="Execute">
          <command>conky --daemonize --pause</command>
        </action>
      </item>
      <item label="Plank (Dock)">
        <action name="Execute">
          <command>plank</command>
        </action>
      </item>
    </menu>

    <!-- ============ UTILITÁRIOS ============ -->
    <menu id="Utilitario" label="Utilitário">
      <item label="Gerenciador de Arquivos (PCManFM)">
        <action name="Execute">
          <command>pcmanfm</command>
        </action>
      </item>
      <item label="Terminal (LXTerminal)">
        <action name="Execute">
          <command>lxterminal</command>
        </action>
      </item>
      <item label="Xarchiver (Compactador)">
        <action name="Execute">
          <command>xarchiver</command>
        </action>
      </item>
    </menu>

    <!-- ============ ENERGIA ============ -->
    <separator />
    <menu id="Energia" label="Energia">
      <item label="Reiniciar Openbox">
        <action name="Reconfigure" />
      </item>
      <item label="Sair da Sessão">
        <action name="Exit" />
      </item>
      <separator />
      <item label="Reiniciar Computador">
        <action name="Execute">
          <command>sudo reboot</command>
        </action>
      </item>
      <item label="Desligar Computador">
        <action name="Execute">
          <command>sudo shutdown -h now</command>
        </action>
      </item>
    </menu>

  </menu>
</openbox_menu>