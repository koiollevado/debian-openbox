-- vim: ts=4 sw=4 noet ai cindent syntax=lua
-- conkyrc — versão Debian 12 / Conky 1.15
-- Ajustado para openbox-mini. Edite as linhas marcadas com "# AJUSTE".

conky.config = {
    alignment = 'top_right',
    background = true,
    cpu_avg_samples = 2,
    default_color = 'white',
    default_outline_color = 'white',
    default_shade_color = 'white',
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    use_xft = true,
    font = 'DejaVu Sans Mono:size=12',
    gap_x = 5,
    gap_y = 6,
    minimum_height = 5,
    minimum_width = 5,
    net_avg_samples = 2,
    no_buffers = true,
    out_to_console = false,
    out_to_stderr = false,
    extra_newline = false,
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    update_interval = 1.0,
    uppercase = false,
    show_graph_scale = false,
    show_graph_range = false,
    own_window_transparent = true,
    -- CORREÇÃO: era 'garb', o correto é 'argb'
    own_window_argb_visual = true,
    -- opcional: define a opacidade do fundo (0-255). 0 = totalmente transparente
    own_window_argb_value = 0,
};

conky.text = [[
${scroll 16 $nodename - $sysname $kernel on $machine }
$hr
${color grey}Tempo de atividade:$color $uptime
${color grey}RAM Usada:$color $mem/$memmax - $memperc% ${membar 4}
${color grey}Swap Usada:$color $swap/$swapmax - $swapperc% ${swapbar 4}
${color grey}CPU Usado:$color $cpu% ${cpubar 4}
${color grey}Processos:$color $processes ${color grey}Running:$color $running_processes
$hr
${color grey}Uso do disco:$color ${fs_used /}/${fs_size /} ${fs_bar 6 /}
${color green}Tráfego de rede:
Up:$color ${upspeed ${upspeedf enp4s4} } ${color green} - Down:$color ${downspeed enp4s4}
$hr
${alignc}${color #FF0412}${font DejaVu Sans:bold:size=16}${time %H:%M:%S}${font}${color}
${alignc}${font DejaVu Sans:bold:size=11}${time %A}, ${time %e} de ${time %B} de ${time %G}${font}
$hr
${font Monospace:size=9}${color0}${execpi 300 DJS=`date +%_d`; ncal -b -h|sed '1,8!d'| sed '/./!d' | sed 's/^/${goto 120} /'| sed 's/$/ /' | sed 's/^/ /' | sed /" $DJS "/s/" $DJS "/" "'${font Monospace=Bold:size=9}${voffset -1}${color red} '"$DJS"'${color}${font Monospace:size=9}'" "/}${voffset -1}
]]